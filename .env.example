# Copy to .env.local and fill in. .env.local is gitignored.

# Postgres + PostGIS (docker-compose.yml provisions this locally)
DATABASE_URL="postgresql://norwaymap:devpassword@localhost:5432/norwaymap"

# Admin auth
# 32+ char random string used to encrypt the session cookie, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# bcrypt hash of the single admin password (never store the plaintext). Generate:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'your-password'
# Escape every '$' as '\$' — @next/env runs dotenv-expand, which otherwise eats
# the hash's '$2b$12$...' segments.
ADMIN_PASSWORD_HASH=""
